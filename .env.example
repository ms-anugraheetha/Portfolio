# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design — they are shipped to the browser and all
# writes are protected by Row Level Security in the database.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key in any VITE_ variable.
